    "id": "stage1_header"
   },
   "source": [
    "---\n",
    "## Stage 1: Generate training data\n",
    "**Cost:** $0 (uses HuggingFace datasets) | **Runtime:** ~3h\n",
    "\n",
    "Uses GooAQ's existing question→answer pairs. No API key needed.\n",
    "Writes directly to Drive — survives session timeouts.\n",
    "Skip if `data/synthetic_training_data.jsonl` already exists on Drive."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "stage1"
   },
   "source": [
    "# ============================================================\n",
    "# STAGE 1: Generate synthetic training data\n",
    "# Writes directly to Drive — checkpoints survive session breaks\n",
    "# ============================================================\n",
    "DRIVE_DATA_FILE = f\"{DRIVE_ROOT}/data/synthetic_training_data.jsonl\"\n",
    "LOCAL_DATA_FILE = f\"{LOCAL_ROOT}/data/synthetic_training_data.jsonl\"\n",
    "\n",
    "if os.path.exists(DRIVE_DATA_FILE):\n",
    "    lines = len(open(DRIVE_DATA_FILE).readlines())\n",
    "    print(f\"\\u2705 Stage 1 already complete \\u2014 {lines} examples on Drive\")\n",
    "else:\n",
    "    print(\"\\U0001f680 Generating training data from HuggingFace datasets...\")\n",
    "    print(\"    Uses GooAQ question-answer pairs (free, no API needed)\")\n",
    "    os.chdir(LOCAL_ROOT)\n",
    "    os.makedirs(f\"{DRIVE_ROOT}/data\", exist_ok=True)\n",
    "    !python training/01_generate_synthetic_data.py \\\n",
    "        --output_path {DRIVE_DATA_FILE} \\\n",
    "        --corpus_name sentence-transformers/gooaq \\\n",
    "        --n_queries 50000 \\\n",
    "        --n_negatives 4\n",
    "    if os.path.exists(DRIVE_DATA_FILE):\n",
    "        shutil.copy2(DRIVE_DATA_FILE, LOCAL_DATA_FILE)\n",
    "        import json as _json\n",
    "        with open(DRIVE_DATA_FILE) as _f:\n",
    "            _rows = [_json.loads(l) for l in _f]\n",
    "        _spreads = [max(r[\"teacher_scores\"]) - min(r[\"teacher_scores\"]) for r in _rows[:1000]]\n",
    "        _avg_spread = sum(_spreads) / len(_spreads)\n",
    "        print(f\"\\u2705 Stage 1 complete \\u2014 {len(_rows)} examples saved to Drive\")\n",
    "        print(f\"   Avg teacher-score spread (first 1000): {_avg_spread:.4f}  (must be > 0 for ranking signal)\")\n",
    "        if _avg_spread < 1e-3:\n",
    "            print(\"   \\u26a0\\ufe0f WARNING: teacher scores have near-zero spread \\u2014 retrain with a stronger teacher\")\n",
    "    else:\n",
    "        print(\"\\u26a0\\ufe0f  Stage 1 did not produce output. Check logs above.\")\n",
    "\n",
    "os.chdir(LOCAL_ROOT)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "stage2_header"
   },
   "source": [
    "---\n",
    "## Stage 2: Knowledge Distillation\n",
    "**Runtime:** ~3h on T4 | Trains ModernBERT from teacher soft labels.\n",
    "\n",
    "Adjust `MODEL_SIZE` below:\n",
    "- `\"base\"`  = 149M params, full fine-tune, batch 8, ~3h\n",
    "- `\"large\"` = 395M params, LoRA fine-tune, batch 4, ~3h\n",
    "\n",
    "> \u23f1\ufe0f If session drops mid-stage, re-run. It skips if output already exists."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "stage2"
   },
   "source": [
    "# ============================================================\n",
    "# STAGE 2: Knowledge Distillation\n",
    "# ============================================================\n",
    "MODEL_SIZE = \"base\"\n",
    "MODEL_NAME = f\"answerdotai/ModernBERT-{MODEL_SIZE}\"\n",
    "KD_OUTPUT  = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-kd-en\"\n",
    "DRIVE_KD   = f\"{DRIVE_ROOT}/models/flashrank-pro-{MODEL_SIZE}-kd-en\"\n",
    "\n",
    "os.chdir(LOCAL_ROOT)\n",
    "\n",
    "if os.path.exists(f\"{DRIVE_KD}/model.safetensors\") or os.path.exists(f\"{DRIVE_KD}/pytorch_model.bin\"):\n",
    "    print(f\"\\u2705 Stage 2 ({MODEL_SIZE}) already complete on Drive\")\n",
    "else:\n",
    "    if os.path.exists(f\"{KD_OUTPUT}/model.safetensors\") or os.path.exists(f\"{KD_OUTPUT}/pytorch_model.bin\"):\n",
    "        print(f\"\\u2705 Stage 2 ({MODEL_SIZE}) already complete locally\")\n",
    "    else:\n",
    "        if os.path.exists(KD_OUTPUT):\n",
    "            shutil.rmtree(KD_OUTPUT)\n",
    "            print(f\"    \\U0001f9f9 Cleaned stale {KD_OUTPUT}\")\n",
    "        if not os.path.exists(f\"{LOCAL_ROOT}/data/synthetic_training_data.jsonl\"):\n",
    "            print(\"\\u274c Run Stage 1 first (no training data found)\")\n",
    "        else:\n",
    "            lora_flag = \"--use_lora\" if MODEL_SIZE == \"large\" else \"\"\n",
    "            bs = 8 if MODEL_SIZE == \"base\" else 4\n",
    "            print(f\"\\U0001f680 KD: {MODEL_NAME} | LoRA: {'yes' if lora_flag else 'no'} | batch: {bs}\")\n",
    "            cmd = [\"python\", \"training/02_knowledge_distillation.py\",\n",
    "                   \"--model_name\", MODEL_NAME,\n",
    "                   \"--data_path\", \"data/synthetic_training_data.jsonl\",\n",
    "                   \"--output_dir\", KD_OUTPUT,\n",
    "                   \"--batch_size\", str(bs),\n",
    "                   \"--num_epochs\", \"3\",\n",
    "                   \"--learning_rate\", \"2e-5\"]\n",
    "            if lora_flag:\n",
    "                cmd.extend([lora_flag, \"--lora_r\", \"16\"])\n",
    "            result = subprocess.run(cmd)\n",
    "            if result.returncode != 0:\n",
    "                raise RuntimeError(f\"Stage 2 failed with exit code {result.returncode}\")\n",
    "\n",
    "            if os.path.exists(f\"{KD_OUTPUT}/model.safetensors\"):\n",
    "                import torch\n",
    "                from safetensors.torch import load_file\n",
    "                sd = load_file(f\"{KD_OUTPUT}/model.safetensors\")\n",
    "                bad = [k for k, v in sd.items() if torch.isnan(v).any() or torch.isinf(v).any()]\n",
    "                if bad:\n",
    "                    print(f\"\\u274c Stage 2 checkpoint has NaN/inf in {len(bad)} tensors \\u2014 deleting, retrain.\")\n",
    "                    shutil.rmtree(KD_OUTPUT)\n",
    "                else:\n",
    "                    os.makedirs(os.path.dirname(DRIVE_KD), exist_ok=True)\n",
    "                    shutil.copytree(KD_OUTPUT, DRIVE_KD)\n",
    "                    print(f\"\\u2705 Stage 2 complete \\u2014 saved to Drive (weights verified clean)\")\n",
    "            else:\n",
    "                print(\"\\u26a0\\ufe0f  Output weights not found. Check logs above.\")\n",
    "\n",
    "os.chdir(LOCAL_ROOT)"
   ],
   "execution_count": null,
   "outputs": []
  },
