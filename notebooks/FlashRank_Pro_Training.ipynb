    "id": "stage3_header"
   },
   "source": [
    "---\n",
    "## Stage 3: GRPO Reinforcement Learning\n",
    "**Runtime:** ~1-2h | RL prompt warmup + fine-grained scoring.\n",
    "\n",
    "Requires Stage 2 checkpoint as starting point."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "stage3"
   },
   "source": [
    "# ============================================================\n",
    "# STAGE 3: GRPO RL Fine-Tuning\n",
    "# ============================================================\n",
    "RL_INPUT  = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-kd-en\"\n",
    "RL_OUTPUT = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-rl\"\n",
    "DRIVE_RL  = f\"{DRIVE_ROOT}/models/flashrank-pro-{MODEL_SIZE}-rl\"\n",
    "\n",
    "os.chdir(LOCAL_ROOT)\n",
    "\n",
    "if os.path.exists(f\"{DRIVE_RL}/model.safetensors\") or os.path.exists(f\"{DRIVE_RL}/pytorch_model.bin\"):\n",
    "    print(f\"\\u2705 Stage 3 already complete on Drive\")\n",
    "else:\n",
    "    if os.path.exists(f\"{RL_OUTPUT}/model.safetensors\") or os.path.exists(f\"{RL_OUTPUT}/pytorch_model.bin\"):\n",
    "        print(f\"\\u2705 Stage 3 already complete locally\")\n",
    "    else:\n",
    "        if not os.path.exists(RL_INPUT):\n",
    "            print(f\"\\u274c {RL_INPUT} not found. Run Stage 2 first.\")\n",
    "        else:\n",
    "            print(f\"\\U0001f680 GRPO RL on {MODEL_SIZE} | max_docs=5 | 1 epoch\")\n",
    "            result = subprocess.run([\"python\", \"training/03_grpo_rl.py\",\n",
    "                   \"--model_path\", RL_INPUT,\n",
    "                   \"--data_path\", \"data/synthetic_training_data.jsonl\",\n",
    "                   \"--output_dir\", RL_OUTPUT,\n",
    "                   \"--batch_size\", \"4\",\n",
    "                   \"--max_docs\", \"5\",\n",
    "                   \"--num_epochs\", \"1\"])\n",
    "            if result.returncode != 0:\n",
    "                raise RuntimeError(f\"Stage 3 failed with exit code {result.returncode}\")\n",
    "\n",
    "            if os.path.exists(f\"{RL_OUTPUT}/model.safetensors\"):\n",
    "                os.makedirs(os.path.dirname(DRIVE_RL), exist_ok=True)\n",
    "                shutil.copytree(RL_OUTPUT, DRIVE_RL)\n",
    "                print(f\"\\u2705 Stage 3 complete \\u2014 saved to Drive\")\n",
    "\n",
    "os.chdir(LOCAL_ROOT)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "stage4_header"
   },
   "source": [
    "---\n",
    "## Stage 4: SLERP Merge\n",
    "**Runtime:** ~5min | Merges KD + RL checkpoints into final model."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "stage4"
   },
   "source": [
    "# ============================================================\n",
    "# STAGE 4: SLERP Merge\n",
    "# ============================================================\n",
    "MERGED_OUTPUT = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-merged\"\n",
    "DRIVE_MERGED  = f\"{DRIVE_ROOT}/models/flashrank-pro-{MODEL_SIZE}-merged\"\n",
    "KD_PATH       = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-kd-en\"\n",
    "RL_PATH       = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-rl\"\n",
    "KD_MULTI_PATH = f\"{LOCAL_ROOT}/models/flashrank-pro-{MODEL_SIZE}-kd-multilingual\"\n",
    "\n",
    "os.chdir(LOCAL_ROOT)\n",
    "\n",
    "if os.path.exists(f\"{DRIVE_MERGED}/model.safetensors\") or os.path.exists(f\"{DRIVE_MERGED}/pytorch_model.bin\"):\n",
    "    print(f\"\\u2705 Stage 4 already complete on Drive\")\n",
    "else:\n",
    "    if os.path.exists(f\"{MERGED_OUTPUT}/model.safetensors\") or os.path.exists(f\"{MERGED_OUTPUT}/pytorch_model.bin\"):\n",
    "        print(f\"\\u2705 Stage 4 already complete locally\")\n",
    "    else:\n",
    "        available = []\n",
    "        for ckpt in [KD_PATH, KD_MULTI_PATH, RL_PATH]:\n",
    "            if os.path.exists(ckpt):\n",
    "                available.append(ckpt)\n",
    "\n",
    "        if len(available) < 2:\n",
    "            print(f\"\\u26a0\\ufe0f  Need \\u22652 checkpoints, found {len(available)}. Copying single...\")\n",
    "            if available:\n",
    "                shutil.copytree(available[0], MERGED_OUTPUT)\n",
    "        else:\n",
    "            weights = [1.0 / len(available)] * len(available)\n",
    "            slerp_cfg = {\"checkpoints\": available, \"weights\": weights}\n",
    "            os.makedirs(\"configs\", exist_ok=True)\n",
    "            with open(\"configs/slerp_config.json\", \"w\") as f:\n",
    "                json.dump(slerp_cfg, f)\n",
    "            print(f\"\\U0001f680 Merging {len(available)} checkpoints: {[Path(c).stem for c in available]}\")\n",
    "            result = subprocess.run([\"python\", \"training/04_slerp_merge.py\",\n",
    "                   \"--config_path\", \"configs/slerp_config.json\",\n",
    "                   \"--output_path\", MERGED_OUTPUT])\n",
    "            if result.returncode != 0:\n",
    "                raise RuntimeError(f\"Stage 4 failed with exit code {result.returncode}\")\n",
    "\n",
    "    if os.path.exists(MERGED_OUTPUT):\n",
    "        os.makedirs(os.path.dirname(DRIVE_MERGED), exist_ok=True)\n",
    "        shutil.copytree(MERGED_OUTPUT, DRIVE_MERGED)\n",
    "        print(f\"\\u2705 Stage 4 complete \\u2014 final model saved to Drive\")\n",
    "\n",
    "os.chdir(LOCAL_ROOT)"
   ],
