   "source": [
    "# FlashRank-Pro Training Pipeline\n",
    "---\n",
    "**Built by [Eulogik](https://eulogik.com)**\n",
    "\n",
    "Resumable notebook for Colab T4. Each stage saves to Google Drive.\n",
    "If the session drops, just **Runtime → Run all** — it picks up where it left off.\n",
    "\n",
    "**Fresh account?** This notebook is self-contained: it clones the repo, generates data (Stage 1), trains, and merges. All intermediate artifacts persist to Google Drive (`MyDrive/flashrank-pro/`) so you can resume after a disconnect.\n",
    "\n",
    "> ⚠️ **Do NOT copy a `models/` or `data/` folder from a prior run** unless you verified the checkpoints are not NaN-corrupted. A corrupted Stage 2 checkpoint silently breaks Stage 3. Let the notebook regenerate from scratch for a clean run.\n",
    "\n",
    "---\n",
    "## Before you start\n",
    "\n",
    "### Get this notebook into Colab\n",
    "Since the repo is private, use one of these:\n",
    "  - **A)** Download notebook from your local clone and upload to Colab (File → Upload notebook)\n",
    "  - **B)** Add `GH_TOKEN` secret (🔑 Secrets panel) with a GitHub PAT scoped to `repo` — then Colab can clone directly\n",
    "\n",
    "### Set secrets (optional)\n",
    "In the 🔑 **Secrets** panel (left sidebar):\n",
    "| Secret | Required for | How to get |\n",
    "|--------|-------------|-----------|\n",
    "| `GH_TOKEN` | Cloning private repo in Colab | GitHub Settings → Developer settings → Personal access tokens → `repo` scope |\n",
    "| `LLM_API_KEY` | Stage 1 — optional, for OpenRouter/OpenAI query gen | Provider's API key page |\n",
    "| `HF_TOKEN` | Deploy to HuggingFace | [huggingface.co/settings/tokens](https://huggingface.co/settings/tokens) |\n",
    "\n",
    "### Enable GPU\n",
    "Runtime → Change runtime type → **T4 GPU**\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "setup"
   },
   "source": [
    "# ============================================================\n",
    "# SETUP: Install deps, mount Drive, get repo, resume progress\n",
    "# ============================================================\n",
    "import os, sys, json, shutil, subprocess, time, warnings, urllib.parse\n",
    "from pathlib import Path\n",
    "\n",
    "DRIVE_MOUNT = \"/content/drive\"\n",
    "DRIVE_ROOT  = f\"{DRIVE_MOUNT}/MyDrive/flashrank-pro\"\n",
    "LOCAL_ROOT  = \"/content/flashrank-pro\"\n",
    "GIT_REPO    = \"https://github.com/eulogik/flashrank-pro.git\"\n",
    "SMOKE_TEST = False\n",
    "\n",
    "print(\"\\u26a1 FlashRank-Pro Training Pipeline\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# ---- 1. Install dependencies ----\n",
    "print(\"\\n[1/6] Installing dependencies...\")\n",
    "start = time.time()\n",
    "!pip install -q torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118\n",
    "!pip install -q transformers sentence-transformers accelerate datasets fire tqdm peft openai huggingface-hub torchao>=0.16.0\n",
    "print(f\"    \\u2705 Dependencies ready ({time.time()-start:.0f}s)\")\n",
    "\n",
    "# ---- 2. Mount Google Drive ----\n",
    "print(\"\\n[2/6] Mounting Google Drive...\")\n",
    "from google.colab import drive\n",
    "drive.mount(DRIVE_MOUNT, force_remount=False)\n",
    "os.makedirs(f\"{DRIVE_ROOT}/data\", exist_ok=True)\n",
    "os.makedirs(f\"{DRIVE_ROOT}/models\", exist_ok=True)\n",
    "print(f\"    \\u2705 Drive mounted\")\n",
    "\n",
    "# ---- 3. Get the repo code ----\n",
    "print(\"\\n[3/6] Getting training scripts...\")\n",
    "\n",
    "if os.path.exists(LOCAL_ROOT):\n",
    "    if os.path.exists(os.path.join(LOCAL_ROOT, \".git\")):\n",
    "        print(\"    \\u2705 Code already present \\u2014 pulling latest...\")\n",
    "        subprocess.run([\"git\", \"-C\", LOCAL_ROOT, \"pull\"], capture_output=False, timeout=60)\n",
    "    else:\n",
    "        print(\"    \\u2705 Code already present (no git) \\u2014 skipping update\")\n",
    "else:\n",
    "    cloned = False\n",
    "    try:\n",
    "        from google.colab import userdata\n",
    "        token = userdata.get(\"GH_TOKEN\")\n",
    "        if token and token.strip():\n",
    "            token = token.strip()\n",
    "            print(f\"    Found GH_TOKEN ({token[:7]}...{token[-4:]}, {len(token)} chars)\")\n",
    "            import requests, zipfile, io\n",
    "            headers = {\"Authorization\": f\"Bearer {token}\", \"Accept\": \"application/vnd.github+json\"}\n",
    "            resp = requests.get(\n",
    "                \"https://api.github.com/repos/eulogik/flashrank-pro/zipball/main\",\n",
    "                headers=headers, timeout=120,\n",
    "            )\n",
    "            if resp.status_code == 200:\n",
    "                z = zipfile.ZipFile(io.BytesIO(resp.content))\n",
    "                _tmp = LOCAL_ROOT + \"-tmp\"\n",
    "                z.extractall(_tmp)\n",
    "                _extracted = os.listdir(_tmp)[0]\n",
    "                os.rename(os.path.join(_tmp, _extracted), LOCAL_ROOT)\n",
    "                shutil.rmtree(_tmp, ignore_errors=True)\n",
    "                cloned = True\n",
    "                print(f\"    \\u2705 Downloaded via GH_TOKEN ({len(z.namelist())} files)\")\n",
    "            else:\n",
    "                print(f\"    \\u274c GH_TOKEN download failed (HTTP {resp.status_code})\")\n",
    "                if resp.status_code == 401:\n",
    "                    print(\"     Token invalid or expired. Generate a new one at github.com/settings/tokens\")\n",
    "                elif resp.status_code == 403:\n",
    "                    print(\"     Token lacks `repo` scope or SSO not authorized\")\n",
    "                elif resp.status_code == 404:\n",
    "                    print(\"     Repo not found\")\n",
    "    except Exception as e:\n",
    "        print(f\"    \\u274c GH_TOKEN download error: {e}\")\n",
    "\n",
    "    if not cloned:\n",
    "        print(\"    No GH_TOKEN found. Trying public clone...\")\n",
    "        try:\n",
    "            result = subprocess.run([\"git\", \"clone\", GIT_REPO, LOCAL_ROOT], capture_output=False, timeout=30)\n",
    "            if result.returncode == 0:\n",
    "                cloned = True\n",
    "                print(\"    \\u2705 Cloned (public access)\")\n",
    "            else:\n",
    "                print(f\"    \\u274c Public clone failed (exit {result.returncode})\")\n",
    "        except Exception as e:\n",
    "            print(f\"    \\u274c Public clone error: {e}\")\n",
    "\n",
    "    if not cloned:\n",
    "        print(\"\\n\" + \"=\" * 50)\n",
    "        print(\"\\u26a0\\ufe0f  Could not get the code.\")\n",
    "        print(\"\")\n",
    "        print(\"1. Add GH_TOKEN secret: \\U0001f511 Secrets \\u2192 GH_TOKEN (PAT with `repo` scope)\")\n",
    "        print(\"   Then re-run this cell.\")\n",
    "        print(\"\")\n",
    "        print(\"Upload the repo zip from your local machine:\")\n",
    "        from google.colab import files\n",
    "        uploaded = files.upload()\n",
    "        for fname in uploaded:\n",
    "            !unzip -q {fname} -d /content/\n",
    "            if os.path.exists(f\"/content/{fname.replace('.zip','')}\"):\n",
    "                !mv /content/{fname.replace('.zip','')} {LOCAL_ROOT}\n",
    "            print(f\"    \\u2705 Extracted {fname}\")\n",
    "\n",
    "# ---- 4. Restore previous progress from Drive (always overwrite local) ----\n",
    "print(\"\\n[4/6] Restoring previous progress from Drive...\")\n",
    "for item in [\"data\", \"models\"]:\n",
    "    local_p = Path(LOCAL_ROOT) / item\n",
    "    drive_p = Path(DRIVE_ROOT) / item\n",
    "    if drive_p.exists() and any(drive_p.iterdir()):\n",
    "        if local_p.exists():\n",
    "            shutil.rmtree(str(local_p))\n",
    "        shutil.copytree(str(drive_p), str(local_p))\n",
    "        print(f\"    \\u2705 Restored {item}/ from Drive\")\n",
    "    elif local_p.exists():\n",
    "        print(f\"    \\u2139\\ufe0f  {item}/ exists locally (Drive empty)\")\n",
    "    else:\n",
    "        local_p.mkdir(parents=True, exist_ok=True)\n",
    "        print(f\"    \\U0001f4c1 Created {item}/\")\n",
    "\n",
    "# ---- 5. Check GPU ----\n",
    "print(\"\\n[5/6] Checking GPU...\")\n",
    "import torch\n",
    "if torch.cuda.is_available():\n",
    "    gpu = torch.cuda.get_device_name(0)\n",
    "    mem = torch.cuda.get_device_properties(0).total_memory / 1024**3\n",
    "    print(f\"    \\u2705 {gpu} ({mem:.0f} GB VRAM)\")\n",
    "else:\n",
    "    print(\"    \\u26a0\\ufe0f  No GPU \\u2014 training will be slow\")\n",
    "\n",
    "# ---- 5b. Smoke test (optional) ----\n",
    "if SMOKE_TEST:\n",
    "    print(\"\\n[5b/6] Running smoke test (tiny data, 2 steps each)...\")\n",
    "    start = time.time()\n",
    "    result = subprocess.run([sys.executable, \"scripts/smoke_test.py\"],\n",
    "                            capture_output=False, timeout=600)\n",
    "    elapsed = time.time() - start\n",
    "    if result.returncode == 0:\n",
    "        print(f\"    \\u2705 Smoke test PASSED ({elapsed:.0f}s) \\u2014 pipeline validated\")\n",
    "    else:\n",
    "        raise RuntimeError(f\"Smoke test FAILED (exit {result.returncode}). \"\n",
    "                           f\"Check logs above before running full pipeline.\")\n",
    "\n",
    "# ---- 6. Summary ----\n",
    "print(\"\\n[6/6] Setup complete\")\n",
    "stages = [\n",
    "    (\"data\",     f\"{DRIVE_ROOT}/data/synthetic_training_data.jsonl\"),\n",
    "    (\"kd_en\",    f\"{DRIVE_ROOT}/models/flashrank-pro-base-kd-en\"),\n",
    "    (\"kd_multi\", f\"{DRIVE_ROOT}/models/flashrank-pro-base-kd-multilingual\"),\n",
    "    (\"rl\",       f\"{DRIVE_ROOT}/models/flashrank-pro-base-rl\"),\n",
    "    (\"merged\",   f\"{DRIVE_ROOT}/models/flashrank-pro-base-merged\"),\n",
    "]\n",
    "for name, path in stages:\n",
    "    done = os.path.exists(path)\n",
    "    print(f\"    {'\\u2705' if done else '\\u2b1c'} {name}: {'done' if done else 'pending'}\")\n",
    "print(\"=\" * 50)"
   ],
   "execution_count": null,
   "outputs": []
  },
